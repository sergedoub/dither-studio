{
  "name": "dither-studio",
  "version": "1.0.0",
  "description": "Offline standalone dithering and print studio",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "package": "electron-packager . 'Dither Studio' --platform=darwin --arch=arm64 --out=dist --overwrite --ignore='^/(reference|tests|dist|docs)' --app-bundle-id=com.serge.ditherstudio --icon=assets/icon.icns",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "vite build",
    "start:web": "node web/server.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.3.0",
    "prettier": "^3.9.6",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "fflate": "^0.8.3"
  }
}
