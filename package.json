{
  "name": "dither-studio",
  "version": "1.0.0",
  "description": "Local-first image dithering for the browser and macOS",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "package": "node scripts/package.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "vite build && node scripts/build-notices.mjs",
    "start:web": "node web/server.mjs",
    "pretest": "npm run build:web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@electron/asar": "4.3.0",
    "@electron/packager": "20.3.0",
    "electron": "44.3.0",
    "prettier": "3.9.6",
    "vite": "8.3.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "fflate": "0.8.3"
  },
  "license": "MIT",
  "author": "Serge Doubinski",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sergedoub/dither-studio.git"
  },
  "bugs": {
    "url": "https://github.com/sergedoub/dither-studio/issues"
  },
  "homepage": "https://github.com/sergedoub/dither-studio#readme"
}
